<?xml version="1.0" encoding="utf-8"?>
<!-- Wide widget: icon + status, big countdown, change time, 12-hour strip with hour marks, last update. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_green"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_icon_bg"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/widget_bolt" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textColor="#FF4ADE80"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="СВІТЛО Є" />

        <TextView
            android:id="@+id/queue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#FFC9CDD3"
            android:textSize="11sp"
            android:text="черга 3.2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/nodata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFC9CDD3"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="Немає даних"
            android:visibility="gone" />

        <TextView
            android:id="@+id/at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textColor="#FFC9CDD3"
            android:textSize="15sp"
            android:text="вимкнуть о 14:00" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/strip"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/h0" style="@style/WidgetHour" android:gravity="start" android:text="зараз" />
        <TextView android:id="@+id/h1" style="@style/WidgetHour" android:text="18:00" />
        <TextView android:id="@+id/h2" style="@style/WidgetHour" android:gravity="end" android:text="24:00" />
    </LinearLayout>

    <TextView
        android:id="@+id/updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="#FF7D838C"
        android:textSize="11sp"
        android:text="оновлено 12:00" />
</LinearLayout>
