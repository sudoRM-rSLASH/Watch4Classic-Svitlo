<?xml version="1.0" encoding="utf-8"?>
<!-- "Liquid glass" card: translucent smoky base so the wallpaper shows through, state-coloured tint,
     a bright sheen along the top edge and a hairline rim. RemoteViews cannot blur, so this only imitates it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- translucent base -->
    <item>
        <shape>
            <solid android:color="#8C12161C" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- state tint, strongest in the top-left corner -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="0.0"
                android:gradientRadius="300dp"
                android:startColor="#40FFC14D"
                android:endColor="#00FFC14D" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- glossy sheen: light from above fading out by the middle -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#2EFFFFFF"
                android:centerColor="#08FFFFFF"
                android:centerY="0.35"
                android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- soft reflection at the bottom edge -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#14FFFFFF"
                android:centerColor="#00FFFFFF"
                android:centerY="0.2"
                android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- outer rim -->
    <item>
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- inner rim, a step inside, for depth -->
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#0FFFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
